module

public import Mathlib.ModelTheory.Semantics
public import Mathlib.ModelTheory.Bundled
public import Mathlib.Data.ZMod.Basic

/-!
# Presentations, mathematical structures and clones as theories

The tree draws three boxes at its foundation: Presentations, Mathematical Structures and Clones.
This file settles which of them are mathematical theories, i.e. classes of models of a set of
axioms, and gives each its Lean object.

* **Presentations** (model theory's structures). For a fixed signature `L` they are exactly the
  models of the axiomless theory `(∅ : L.Theory)`: `presentation_models_empty`. So Presentations
  is a theory, one for each signature, with no axioms; `Magmas` (one binary symbol) and monounary
  algebras are its smallest instances. The class of all presentations over all signatures is a
  family of theories, not one theory, because the signature is a parameter.

* **Mathematical structures** are *not* a theory: a mathematical structure is a presentation up
  to isomorphism, a quotient of the models of the theory above and not itself a set with
  operations. `MathStructure L` is that quotient, built on Mathlib's `equivSetoid`;
  `MathStructure.of_eq_iff` says two presentations give the same structure iff they are isomorphic.

* **Clones** *are* a theory, an equational one. `AbstractClone` is the theory of abstract clones
  (P. Hall 1958, Cohn 1965, W. Taylor 1973): one sort `C n` for each arity `n`, the projections and
  superposition, with three equation schemes. Restricting to one arity gives the one-sorted
  `MengerAlgebra n`. Its intended models are the concrete clones: all finitary operations on a set
  (`Ops.instAbstractClone`) and the clone generated by a presentation, the paper's *closed
  mathematical structure* (`Clone.instAbstractClone`). The paper's example that the product of
  `C₃` alone generates its inverse and identity is `c3_inv_mem` and `c3_zero_mem`.
-/

@[expose] public section

namespace MathTree

open FirstOrder FirstOrder.Language

universe u v w

/-! ### Presentations: the axiomless theory of a signature -/

section Presentations

variable (L : Language.{u, v})

/-- A presentation of signature `L` (Mathlib's `L.Structure M`) is a model of the axiomless theory
`∅ : L.Theory`, and conversely every model of it is a structure: the box Presentations is this
theory, one for each signature. -/
theorem presentation_models_empty (M : Type w) [L.Structure M] : M ⊨ (∅ : L.Theory) :=
  inferInstance

/-- A mathematical structure of signature `L`: a presentation up to isomorphism, i.e. an element of
the quotient of the bundled `L`-structures by `≃[L]`. This is a quotient of the models of a theory,
not a theory. -/
def MathStructure : Type (max u v (w + 1)) :=
  Quotient (equivSetoid : Setoid (CategoryTheory.Bundled.{w} L.Structure))

/-- the mathematical structure that a presentation presents -/
def MathStructure.of (M : CategoryTheory.Bundled.{w} L.Structure) : MathStructure.{u, v, w} L :=
  Quotient.mk _ M

/-- Two presentations present the same mathematical structure iff they are isomorphic. -/
theorem MathStructure.of_eq_iff (M N : CategoryTheory.Bundled.{w} L.Structure) :
    MathStructure.of L M = MathStructure.of L N ↔ Nonempty (M ≃[L] N) :=
  Quotient.eq

end Presentations

/-! ### Clones: an equational theory -/

/-- The theory of abstract clones: for every arity `n` a sort `C n` of `n`-ary operations, the
projections `proj i : C n`, and superposition `comp f g : C m` of an `n`-ary `f` with `n` operations
of arity `m`, subject to the identities that term operations satisfy. -/
class AbstractClone (C : ℕ → Type u) where
  /-- the `i`-th projection of arity `n` -/
  proj : ∀ {n : ℕ}, Fin n → C n
  /-- superposition: substitute `g 0, …, g (n-1)` for the variables of `f` -/
  comp : ∀ {n m : ℕ}, C n → (Fin n → C m) → C m
  comp_proj : ∀ {n m : ℕ} (i : Fin n) (g : Fin n → C m), comp (proj i) g = g i
  comp_proj_right : ∀ {n : ℕ} (f : C n), comp f proj = f
  comp_assoc : ∀ {n m k : ℕ} (f : C n) (g : Fin n → C m) (h : Fin m → C k),
    comp (comp f g) h = comp f (fun i => comp (g i) h)

/-- A Menger algebra of rank `n`: the one-sorted theory of the `n`-ary part of a clone, with
projection constants `e i` and superposition `mu`, satisfying superassociativity and the two
projection laws. -/
class MengerAlgebra (n : ℕ) (A : Type u) where
  e : Fin n → A
  mu : A → (Fin n → A) → A
  mu_e : ∀ (i : Fin n) (g : Fin n → A), mu (e i) g = g i
  mu_e_right : ∀ f : A, mu f e = f
  superassoc : ∀ (f : A) (g h : Fin n → A), mu (mu f g) h = mu f (fun i => mu (g i) h)

/-- Each arity of an abstract clone is a Menger algebra. -/
instance AbstractClone.toMengerAlgebra (C : ℕ → Type u) [AbstractClone C] (n : ℕ) :
    MengerAlgebra n (C n) where
  e := AbstractClone.proj
  mu := AbstractClone.comp
  mu_e := AbstractClone.comp_proj
  mu_e_right := AbstractClone.comp_proj_right
  superassoc := AbstractClone.comp_assoc

/-- All finitary operations on a set: `Ops α n` is the set of `n`-ary functions on `α`. -/
abbrev Ops (α : Type u) (n : ℕ) : Type u := (Fin n → α) → α

/-- The full clone of a set is a model of the theory of clones. -/
instance Ops.instAbstractClone (α : Type u) : AbstractClone (Ops α) where
  proj i := fun x => x i
  comp f g := fun x => f (fun i => g i x)
  comp_proj _ _ := rfl
  comp_proj_right _ := rfl
  comp_assoc _ _ _ := rfl

/-- The compositional closure of a family `G` of generating operations (a presentation's chosen
functions, arity by arity): the generators, the projections, and superpositions of generated
operations. -/
inductive Generated {α : Type u} (G : ∀ n, Set (Ops α n)) : ∀ n, Ops α n → Prop
  | gen {n : ℕ} {f : Ops α n} (h : f ∈ G n) : Generated G n f
  | proj {n : ℕ} (i : Fin n) : Generated G n (fun x => x i)
  | comp {n m : ℕ} {f : Ops α n} {g : Fin n → Ops α m} (hf : Generated G n f)
      (hg : ∀ i, Generated G m (g i)) : Generated G m (fun x => f (fun i => g i x))

/-- The clone generated by `G`: the paper's closed mathematical structure of a presentation. -/
def Clone {α : Type u} (G : ∀ n, Set (Ops α n)) (n : ℕ) : Type u :=
  {f : Ops α n // Generated G n f}

/-- The clone generated by a presentation is a model of the theory of clones. -/
instance Clone.instAbstractClone {α : Type u} (G : ∀ n, Set (Ops α n)) :
    AbstractClone (Clone G) where
  proj i := ⟨fun x => x i, Generated.proj i⟩
  comp f g := ⟨fun x => f.1 (fun i => (g i).1 x), Generated.comp f.2 (fun i => (g i).2)⟩
  comp_proj _ _ := Subtype.ext rfl
  comp_proj_right _ := Subtype.ext rfl
  comp_assoc _ _ _ := Subtype.ext rfl

/-- Every generator lies in the clone it generates. -/
theorem Generated.of_mem {α : Type u} (G : ∀ n, Set (Ops α n)) {n : ℕ} {f : Ops α n}
    (h : f ∈ G n) : Generated G n f :=
  Generated.gen h

/-! ### Example: the cyclic group `C₃` from its product alone -/

/-- The presentation of `C₃ = ℤ/3` by its product (here written additively) alone. -/
def c3Product : ∀ n, Set (Ops (ZMod 3) n)
  | 2 => {fun x => x 0 + x 1}
  | _ => ∅

theorem c3Product_mem : (fun x : Fin 2 → ZMod 3 => x 0 + x 1) ∈ c3Product 2 := by
  simp [c3Product]

/-- The inverse of `C₃` is generated by the product: `-a = a + a`. -/
theorem c3_inv_mem : Generated c3Product 1 (fun x => -x 0) := by
  have h := Generated.comp (G := c3Product) (m := 1) (g := fun _ => fun x => x 0)
    (Generated.gen c3Product_mem) (fun _ => Generated.proj 0)
  convert h using 1
  funext x
  generalize x 0 = a
  revert a
  decide

/-- The identity of `C₃` is generated by the product: `0 = a + (a + a)`. -/
theorem c3_zero_mem : Generated c3Product 1 (fun _ => 0) := by
  have h := Generated.comp (G := c3Product) (m := 1)
    (g := fun i => if i = 0 then (fun x => x 0) else (fun x => -x 0))
    (Generated.gen c3Product_mem)
    (fun i => by
      by_cases hi : i = 0
      · simp only [hi, ite_true]; exact Generated.proj 0
      · simp only [hi, ite_false]; exact c3_inv_mem)
  convert h using 1
  funext x
  simp only [Fin.isValue, ite_true, show (1 : Fin 2) ≠ 0 by decide, ite_false]
  generalize x 0 = a
  revert a
  decide

/-! ### The term functions of a Mathlib structure are exactly its generated clone -/

section TermFunctions

variable {L : Language.{u, v}} {M : Type w} [L.Structure M]

/-- The generating family of a presentation `L.Structure M`: the interpretations of its function
symbols, arity by arity. -/
def funOps (L : Language.{u, v}) (M : Type w) [L.Structure M] : ∀ n, Set (Ops M n) :=
  fun n => Set.range (fun f : L.Functions n => (Structure.funMap f : (Fin n → M) → M))

/-- Every term function (Mathlib's `Term.realize`) lies in the clone generated by the structure's
function symbols. -/
theorem generated_of_term {n : ℕ} (t : L.Term (Fin n)) :
    Generated (funOps L M) n (fun v => t.realize v) := by
  induction t with
  | var i => exact Generated.proj i
  | func f ts ih => exact Generated.comp (Generated.gen ⟨f, rfl⟩) ih

/-- Conversely every function of the generated clone is a term function: superposition is term
substitution (`Term.subst`), and `realize_subst` is the computation. -/
theorem exists_term_of_generated {n : ℕ} {g : Ops M n} (h : Generated (funOps L M) n g) :
    ∃ t : L.Term (Fin n), g = fun v => t.realize v := by
  induction h with
  | gen hf =>
    obtain ⟨f, rfl⟩ := hf
    exact ⟨func f var, rfl⟩
  | proj i => exact ⟨var i, rfl⟩
  | comp _ _ ihf ihg =>
    obtain ⟨t, rfl⟩ := ihf
    choose s hs using ihg
    refine ⟨t.subst s, ?_⟩
    funext v
    simp only [Term.realize_subst]
    congr 1
    funext i
    rw [hs i]

/-- The clone of a presentation is its set of term functions: Mathlib's `Term.realize` and this
file's `Generated` describe the same functions. -/
theorem generated_iff_term {n : ℕ} (g : Ops M n) :
    Generated (funOps L M) n g ↔ ∃ t : L.Term (Fin n), g = fun v => t.realize v :=
  ⟨exists_term_of_generated, fun ⟨t, ht⟩ => ht ▸ generated_of_term t⟩

end TermFunctions

/-! ### Examples of mutual generation from the atlas: `C₃` by division, the Boolean connectives -/

/-- `C₃` by division alone, `a / b = a - b` (additively). -/
def c3Division : ∀ n, Set (Ops (ZMod 3) n)
  | 2 => {fun x => x 0 - x 1}
  | _ => ∅

theorem c3Division_mem : (fun x : Fin 2 → ZMod 3 => x 0 - x 1) ∈ c3Division 2 := by
  simp [c3Division]

/-- Division generates the product: `a + b = a - ((b - b) - b)`. -/
theorem c3_add_mem_division : Generated c3Division 2 (fun x => x 0 + x 1) := by
  have t1 : Generated c3Division 2 (fun x => x 1 - x 1) :=
    Generated.comp (G := c3Division) (m := 2) (g := fun _ => fun x => x 1)
      (Generated.gen c3Division_mem) (fun _ => Generated.proj 1)
  have t2 : Generated c3Division 2 (fun x => (x 1 - x 1) - x 1) := by
    have h := Generated.comp (G := c3Division) (m := 2)
      (g := fun i => if i = 0 then (fun x => x 1 - x 1) else (fun x => x 1))
      (Generated.gen c3Division_mem)
      (fun i => by
        by_cases hi : i = 0
        · simp only [hi, ite_true]; exact t1
        · simp only [hi, ite_false]; exact Generated.proj 1)
    convert h using 1
    funext x
    simp only [Fin.isValue, ite_true, show (1 : Fin 2) ≠ 0 by decide, ite_false]
  have h := Generated.comp (G := c3Division) (m := 2)
    (g := fun i => if i = 0 then (fun x => x 0) else (fun x => (x 1 - x 1) - x 1))
    (Generated.gen c3Division_mem)
    (fun i => by
      by_cases hi : i = 0
      · simp only [hi, ite_true]; exact Generated.proj 0
      · simp only [hi, ite_false]; exact t2)
  convert h using 1
  funext x
  simp only [Fin.isValue, ite_true, show (1 : Fin 2) ≠ 0 by decide, ite_false]
  generalize x 0 = a
  generalize x 1 = b
  revert a b
  decide

/-- The product generates division: `a - b = a + (b + b)`. -/
theorem c3_sub_mem_product : Generated c3Product 2 (fun x => x 0 - x 1) := by
  have t1 : Generated c3Product 2 (fun x => x 1 + x 1) :=
    Generated.comp (G := c3Product) (m := 2) (g := fun _ => fun x => x 1)
      (Generated.gen c3Product_mem) (fun _ => Generated.proj 1)
  have h := Generated.comp (G := c3Product) (m := 2)
    (g := fun i => if i = 0 then (fun x => x 0) else (fun x => x 1 + x 1))
    (Generated.gen c3Product_mem)
    (fun i => by
      by_cases hi : i = 0
      · simp only [hi, ite_true]; exact Generated.proj 0
      · simp only [hi, ite_false]; exact t1)
  convert h using 1
  funext x
  simp only [Fin.isValue, ite_true, show (1 : Fin 2) ≠ 0 by decide, ite_false]
  generalize x 0 = a
  generalize x 1 = b
  revert a b
  decide

/-- The two-element Boolean algebra by the Sheffer stroke (NAND) alone. -/
def nandOps : ∀ n, Set (Ops Bool n)
  | 2 => {fun x => !(x 0 && x 1)}
  | _ => ∅

/-- The two-element Boolean algebra by NOT and OR. -/
def notOrOps : ∀ n, Set (Ops Bool n)
  | 1 => {fun x => !x 0}
  | 2 => {fun x => x 0 || x 1}
  | _ => ∅

theorem nandOps_mem : (fun x : Fin 2 → Bool => !(x 0 && x 1)) ∈ nandOps 2 := by simp [nandOps]
theorem notOrOps_not_mem : (fun x : Fin 1 → Bool => !x 0) ∈ notOrOps 1 := by simp [notOrOps]
theorem notOrOps_or_mem : (fun x : Fin 2 → Bool => x 0 || x 1) ∈ notOrOps 2 := by simp [notOrOps]

/-- NAND generates NOT: `¬a = a | a`. -/
theorem not_mem_nand : Generated nandOps 1 (fun x => !x 0) := by
  have h := Generated.comp (G := nandOps) (m := 1) (g := fun _ => fun x => x 0)
    (Generated.gen nandOps_mem) (fun _ => Generated.proj 0)
  convert h using 1
  funext x
  generalize x 0 = a
  revert a
  decide

/-- NAND generates OR: `a ∨ b = (a | a) | (b | b)`. -/
theorem or_mem_nand : Generated nandOps 2 (fun x => x 0 || x 1) := by
  have t : ∀ j : Fin 2, Generated nandOps 2 (fun x => !(x j && x j)) := fun j =>
    Generated.comp (G := nandOps) (m := 2) (g := fun _ => fun x => x j)
      (Generated.gen nandOps_mem) (fun _ => Generated.proj j)
  have h := Generated.comp (G := nandOps) (m := 2)
    (g := fun i => if i = 0 then (fun x => !(x 0 && x 0)) else (fun x => !(x 1 && x 1)))
    (Generated.gen nandOps_mem)
    (fun i => by
      by_cases hi : i = 0
      · simp only [hi, ite_true]; exact t 0
      · simp only [hi, ite_false]; exact t 1)
  convert h using 1
  funext x
  simp only [Fin.isValue, ite_true, show (1 : Fin 2) ≠ 0 by decide, ite_false]
  generalize x 0 = a
  generalize x 1 = b
  revert a b
  decide

/-- NOT and OR generate NAND: `a | b = ¬a ∨ ¬b`. -/
theorem nand_mem_notOr : Generated notOrOps 2 (fun x => !(x 0 && x 1)) := by
  have t : ∀ j : Fin 2, Generated notOrOps 2 (fun x => !x j) := fun j =>
    Generated.comp (G := notOrOps) (m := 2) (g := fun _ => fun x => x j)
      (Generated.gen notOrOps_not_mem) (fun _ => Generated.proj j)
  have h := Generated.comp (G := notOrOps) (m := 2)
    (g := fun i => if i = 0 then (fun x => !x 0) else (fun x => !x 1))
    (Generated.gen notOrOps_or_mem)
    (fun i => by
      by_cases hi : i = 0
      · simp only [hi, ite_true]; exact t 0
      · simp only [hi, ite_false]; exact t 1)
  convert h using 1
  funext x
  simp only [Fin.isValue, ite_true, show (1 : Fin 2) ≠ 0 by decide, ite_false]
  generalize x 0 = a
  generalize x 1 = b
  revert a b
  decide

end MathTree
